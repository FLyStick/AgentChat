# ============================================================
# AgentChat 配置模板（上传 GitHub 用）
# 使用方法：
#   1. 复制本文件为 config.yaml：cp config.yaml.example config.yaml
#   2. 将下方所有 your-xxx 占位符替换为你自己的真实密钥
#   3. config.yaml 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# 服务配置
server:
  env: "dev" # prod / test / dev
  host: "127.0.0.1"
  port: 7860
  name: "AgentChat" # 项目名称
  version: "2.5.0" # 服务版本号

# 数据库配置：MySQL (请根据实际配置更改 endpoint)
# 格式：mysql+pymysql://<user>:<password>@<host>:<port>/<database>
mysql:
  endpoint: "mysql+pymysql://root:${MYSQL_PASSWORD:-your-mysql-password}@localhost:3306/agentchat" # 同步连接配置
  async_endpoint: "mysql+aiomysql://root:${MYSQL_PASSWORD:-your-mysql-password}@localhost:3306/agentchat" # 异步连接配置

# 缓存配置：Redis
redis:
  endpoint: "redis://localhost:6379" # Redis 连接地址

# 多模型服务配置 (LLM、Embedding、Rerank)
multi_models:
  # 对话模型配置
  conversation_model:
    api_key: "${AGENTCHAT_ALIYUN_API_KEY:-your-api-key}"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    model_name: "qwen-plus"
  # 工具调用/Function Call 模型配置
  tool_call_model:
    api_key: "${AGENTCHAT_ALIYUN_API_KEY:-your-api-key}"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    model_name: "qwen-plus"
  # 复杂推理模型配置
  reasoning_model:
    api_key: "${AGENTCHAT_DEEPSEEK_API_KEY:-your-api-key}"
    base_url: "https://api.deepseek.com/v1"
    model_name: "deepseek-reasoner"
  # 文生图模型配置
  text2image:
    api_key: "${AGENTCHAT_ALIYUN_API_KEY:-your-api-key}"
    base_url: "https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis"
    model_name: "wanx2.0-t2i-turbo"
  # 多模态 (视觉) 模型配置
  qwen_vl:
    api_key: "${AGENTCHAT_ALIYUN_API_KEY:-your-api-key}"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    model_name: "qwen-vl-plus"

  # Embedding 模型配置 (用于向量化)
  embedding:
    api_key: "${AGENTCHAT_ALIYUN_API_KEY:-your-api-key}"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    model_name: "text-embedding-v4"

  # Rerank 模型配置 (用于重排序召回结果)
  # DashScope 原生路由示例：
  #   https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
  # 若使用 MaaS 网关，请将 base_url 替换为网关自己的 rerank 原生路由：
  #   https://<gateway-host>/api/v1/services/rerank/text-rerank/text-rerank
  rerank:
    api_key: "${AGENTCHAT_RERANK_API_KEY:-your-rerank-api-key}"
    base_url: "${AGENTCHAT_RERANK_BASE_URL:-https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank}"
    model_name: "gte-rerank-v2"


# 外部工具 (Tool) 配置
tools:
  # 高德地图天气 API 配置
  weather:
    api_key: "${AGENTCHAT_AMAP_API_KEY:-your-amap-api-key}"
    endpoint: "https://restapi.amap.com/v3/weather/weatherInfo?parameters"
  # Tavily 联网搜索 API 配置 (注意配额限制)
  tavily:
    api_key: "${AGENTCHAT_TAVILY_API_KEY:-your-tavily-api-key}"
  # SerpApi 上的 Google Search API 配置
  google:
    api_key: "${AGENTCHAT_SERPAPI_API_KEY:-your-serpapi-api-key}"
  # 阿里云快递查询 API 配置
  delivery:
    api_key: "${AGENTCHAT_DELIVERY_API_KEY:-your-delivery-api-key}"
    endpoint: "https://qyexpress.market.alicloudapi.com/composite/queryexpress"
  # BoCha 联网搜索 API 配置
  bocha:
    api_key: "${AGENTCHAT_BOCHA_API_KEY:-your-bocha-api-key}"
    endpoint: "https://api.bochaai.com/v1/web-search"
  # You.com Search & Research API 配置（获取 API 密钥: https://ydc-index.io/docs）
  youcom:
    api_key: "${AGENTCHAT_YOUCOM_API_KEY:-}"
    endpoint: "https://ydc-index.io/v1/search"

# RAG (检索增强生成) 配置
rag:
  enable_summary: False # 是否对知识库片段进行摘要
  enable_elasticsearch: False # 是否启用 Elasticsearch 进行关键词搜索
  enable_ik_analyzer: False # 是否启用 Elasticsearch 的IK分词器

  retrival:
    top_k: 5  # 知识库召回的最大数量
    min_score: 0.0 # gte-rerank-v2 分数口径较低，0.2 会误过滤相关文档；置 0 后仅按重排顺序截断

  split:
    chunk_size: 500 # 知识库文档分块的最大字符数
    overlap_size: 100 # 文档分块之间的重叠字符数

  # ES数据库配置，主要做关键词召回
  elasticsearch:
    hosts: "http://127.0.0.1:9200" # Elasticsearch 连接地址。如果 'enable_elasticsearch' 为 False，则不需要填写。

  # 向量数据库配置 (Vector DB)
  vector_db:
    host: "127.0.0.1"
    port: "19530"
    mode: "chroma" # 向量库模式: standalone (Milvus), lite (轻量Milvus), chroma (ChromaDB)

# 阿里云对象存储 OSS 配置
storage:
  mode: "minio" # or oss

  oss:
    access_key_id: "${AGENTCHAT_OSS_ACCESS_KEY_ID:-your-oss-access-key-id}"
    access_key_secret: "${AGENTCHAT_OSS_ACCESS_KEY_SECRET:-your-oss-access-key-secret}"
    endpoint: "oss-cn-beijing.aliyuncs.com"
    bucket_name: "agentchat" # OSS 存储桶名称
    base_url: "https://agentchat.oss-cn-beijing.aliyuncs.com" # 访问基础 URL

  minio:
    access_key_id: "${MINIO_ROOT_USER:-your-minio-user}"
    access_key_secret: "${MINIO_ROOT_PASSWORD:-your-minio-password}"
    endpoint: "127.0.0.1:9002"
    bucket_name: "agentchat" # minio 存储桶名称
    base_url: "http://127.0.0.1:9002/agentchat" # 访问基础 URL

# 默认配置 (如图标 URL, 资源链接)
default_config:
  mcp_logo_url: "https://agentchat.oss-cn-beijing.aliyuncs.com/icons/mcp/mcp.png"
  tool_logo_url: "https://agentchat.oss-cn-beijing.aliyuncs.com/icons/tools/default.png" # 工具默认图标 URL
  agent_logo_url: "https://agentchat.oss-cn-beijing.aliyuncs.com/icons/tools/bot.png" # Agent 默认图标 URL
  mars_daily_url: "https://news.aibase.com/zh/news" # 外部新闻链接
  memory_collection_name: "memory" # 记忆存储的集合名称

# 扩展功能：微信配置 (不添加也可正常运行)
wechat_config:
  token: "${AGENTCHAT_WECHAT_TOKEN:-your-wechat-token}"
  app_id: "${AGENTCHAT_WECHAT_APP_ID:-your-wechat-app-id}"
  secret: "${AGENTCHAT_WECHAT_SECRET:-your-wechat-secret}"

# 追踪工具 Langfuse 配置 (目前版本可能未应用)
langfuse:
  trace_name: "agentchat"
  host: "https://cloud.langfuse.com"
  public_key: "${LANGFUSE_PUBLIC_KEY:-your-langfuse-public-key}" # Langfuse 公钥
  secret_key: "${LANGFUSE_SECRET_KEY:-your-langfuse-secret-key}" # Langfuse 私钥
  user_id: "${LANGFUSE_USER_ID:-your-user-id}" # 用户 ID

# 接口白名单路径
whitelist_paths: ["/api/v1/mcp/*"]
